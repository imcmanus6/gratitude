# Optional absolute directory on persistent local disk. Defaults to .data/.
# GRATITUDE_DATA_DIR=/absolute/path/to/gratitude-data

# Social sign-in (server-only). Use this exact origin in provider redirect URLs.
AUTH_ORIGIN=http://localhost:3005
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple requires AUTH_ORIGIN to be a registered HTTPS domain (not localhost/IP).
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the Sign in with Apple .p8 key. In .env.local, use a quoted string with \n line breaks.
APPLE_PRIVATE_KEY=

# Optional, server-only AI gratitude backgrounds. Never expose this key to the browser.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Transactional confirmation, password reset, and daily reminder emails (verified Resend sender).
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Web Push: generate once with web-push.generateVAPIDKeys(); keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:gratitude@iskind.net

# Android TWA App Links: comma-separated SHA-256 fingerprints from Play Console.
ANDROID_ASSETLINKS_SHA256=

# Server-only Supabase PostgreSQL connection. Use the gratitude_app login, never postgres at runtime.
SUPABASE_DATABASE_URL=
# Migration-only administrator connection. Never expose either connection URL in the browser.
SUPABASE_DATABASE_ADMIN_URL=

# Complimentary paid features for everyone; false restores sponsor cards.
GRATITUDE_COMPLIMENTARY_PAID_ACCESS=true
